# Payment link opened by every "Buy Now" button (opens in a new tab).
# Example: your Razorpay / Instamojo / Gumroad / Cashfree payment page URL.
# If unset, buttons fall back to "#".
NEXT_PUBLIC_BUY_URL=

# Your live site URL, without a trailing slash. Used for canonical URLs,
# Open Graph tags, JSON-LD, sitemap.xml and robots.txt.
# Example: https://www.homefurnitureguide.in
NEXT_PUBLIC_SITE_URL=
